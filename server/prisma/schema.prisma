// Prisma Schema for Jagmohan Portfolio Backend
// Node N4: PostgreSQL + Prisma Foundation
// Node N6: Projects System
// Node N7: Admin Authentication

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Foundational health model for N4 database verification & migration testing
model DatabaseHealth {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())

  @@map("database_health")
}

/// Project model for N6 projects catalogue and detail views
model Project {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  description  String
  overview     String?  @db.Text
  category     String   // e.g., "WordPress", "Front-End", "WooCommerce"
  image        String?  // Image path or URL
  technologies String[] // Array of technology tags
  role         String?  // e.g., "Senior WordPress Developer", "Front-End Engineer"
  liveUrl      String?
  githubUrl    String?
  featured     Boolean  @default(false)
  order        Int      @default(0)
  status       String   @default("published") // "published" | "draft"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("projects")
}


/// Admin model for N7 private authentication
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

/// Profile model for N9 singleton profile & about management
model Profile {
  id            String   @id @default(uuid())
  name          String
  headline      String
  location      String
  about         String   @db.Text
  company       String?
  projectsCount String?  @default("80+")
  email         String?
  phone         String?
  linkedin      String?
  github        String?
  avatar        String?
  banner        String?
  services      String[]
  tools         String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("profiles")
}

/// Experience model for N9 work history CRUD
model Experience {
  id           String   @id @default(uuid())
  role         String
  company      String
  type         String?  // e.g. "Full-time", "Internship", "Contract"
  start        String
  end          String?  // e.g. "Present" or "2025"
  isCurrent    Boolean  @default(false)
  location     String?
  bullets      String[]
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("experiences")
}

/// Skill model for N9 skills catalogue CRUD
model Skill {
  id           String   @id @default(uuid())
  name         String
  category     String?  // e.g. "Frontend", "WordPress", "Design Tools", "Backend"
  displayOrder Int      @default(0)
  featured     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("skills")
}

/// Certification model for N10 credentials & certificate management
model Certification {
  id            String   @id @default(uuid())
  name          String
  issuer        String?  // e.g. "Google", "freeCodeCamp", "LinkedIn Learning"
  issueDate     String?  // e.g. "2025" or "Jan 2026"
  credentialUrl String?  // Optional verification URL
  imageUrl      String   // Persistent image URL or reference
  imagePublicId String?  // Cloudinary or storage asset ID
  description   String?  @db.Text
  displayOrder  Int      @default(0)
  featured      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("certifications")
}