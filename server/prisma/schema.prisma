// Prisma Schema for Jagmohan Portfolio Backend
// Node N4: PostgreSQL + Prisma Foundation
// Node N6: Projects System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Foundational health model for N4 database verification & migration testing
model DatabaseHealth {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())

  @@map("database_health")
}

/// Project model for N6 projects catalogue and detail views
model Project {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  description  String
  overview     String?  @db.Text
  category     String   // e.g., "WordPress", "Front-End", "WooCommerce"
  image        String?  // Image path or URL
  technologies String[] // Array of technology tags
  role         String?  // e.g., "Senior WordPress Developer", "Front-End Engineer"
  liveUrl      String?
  githubUrl    String?
  featured     Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("projects")
}